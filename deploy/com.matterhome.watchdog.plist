<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tunnel watchdog. Installed by .github/workflows/deploy-server.yml, which
  substitutes __HOME__ for the real home directory (launchd does not expand
  environment variables in plist paths).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.matterhome.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__HOME__/matter-home/deploy/tunnel-watchdog.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>120</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/matterhome/watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/matterhome/watchdog.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
